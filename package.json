  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "description": "SEKAI 贴纸生成器",
  "license": "AGPL-3.0-only",
  "author": "The 25-ji-code-de Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/25-ji-code-de/stickers-maker.git"
  },
  "homepage": "https://github.com/25-ji-code-de/stickers-maker#readme",
  "bugs": {
    "url": "https://github.com/25-ji-code-de/stickers-maker/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:toy": "vite build --mode toy",
    "build:android": "vite build --mode android",
    "cap:sync": "vite build --mode android && cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@25-ji-code-de/sekai-auth": "github:25-ji-code-de/sekai-auth#v0.2.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.18.0",
    "fast-average-color": "^9.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.1.1",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
